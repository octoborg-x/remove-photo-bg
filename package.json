{
  "name": "remove-bg-photo",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Browser-first background remover for marketplace/product photos (Phase 1: model feasibility smoke test).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "node scripts/run-browser-tests.mjs",
    "eval:set": "python3 scripts/eval/build-eval-set.py --download",
    "eval:run": "node scripts/eval/run-eval.mjs",
    "eval:analyze": "python3 scripts/eval/analyze-eval.py eval-results/wasm",
    "eval:checklist": "python3 scripts/eval/benchmark-checklist.py",
    "eval:benchmark": "python3 scripts/eval/accuracy-benchmark.py",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "fetch-models": "node scripts/fetch-models.mjs",
    "build-demo": "node scripts/build-demo-assets.mjs",
    "eval:gallery:backends": "node scripts/build-eval-gallery.mjs --wasm eval-results/wasm --gpu eval-results/webgpu",
    "eval:gallery:single": "node scripts/build-eval-gallery.mjs --run eval-results/after-145",
    "eval:gallery:merge": "node scripts/merge-eval-galleries.mjs",
    "dev:local": "vite",
    "license:audit": "license-checker-rseidelsohn --production && license-checker-rseidelsohn --summary",
    "analytics:dev": "npx wrangler dev --config cloudflare/analytics-worker/wrangler.toml",
    "analytics:deploy": "npx wrangler deploy --config cloudflare/analytics-worker/wrangler.toml",
    "analytics:migrate:local": "npx wrangler d1 migrations apply smartcutai-reports --local --config cloudflare/analytics-worker/wrangler.toml",
    "analytics:migrate:remote": "npx wrangler d1 migrations apply smartcutai-reports --remote --config cloudflare/analytics-worker/wrangler.toml",
    "vercel:build": "node scripts/fetch-models.mjs --webgpu --no-models && npm run build && node scripts/copy-legal-docs.mjs && node scripts/strip-large-assets.mjs"
  },
  "dependencies": {
    "onnxruntime-web": "1.29.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "onnxruntime-node": "^1.29.0",
    "puppeteer-core": "^23.11.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  }
}
