{
  "name": "remove-bg-photo",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Browser-first background remover for marketplace/product photos (Phase 1: model feasibility smoke test).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:site": "npm run build && node scripts/strip-large-assets.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "fetch-models": "node scripts/fetch-models.mjs"
  },
  "dependencies": {
    "onnxruntime-web": "1.29.0"
  },
  "devDependencies": {
    "onnxruntime-node": "^1.29.0",
    "puppeteer-core": "^23.11.1",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
