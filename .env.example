# First-party, text-only analytics Worker. Empty = analytics off (no banner, no
# events, CSP stays connect-src 'self').
VITE_ANALYTICS_ENDPOINT=
# Remote origin serving the model + WASM (e.g. a Hugging Face Space). Empty =
# same-origin assets.
VITE_ASSET_BASE=
# Cloudflare Web Analytics beacon token. Empty = no beacon is loaded; when set,
# the generated CSP allows static.cloudflareinsights.com (script-src) and
# cloudflareinsights.com (connect-src).
VITE_CF_WEB_ANALYTICS_TOKEN=
