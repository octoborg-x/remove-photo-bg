VITE_ASSET_BASE=
# Base URL of the SmartCutAI analytics Worker (Cloudflare). Leave empty to
# disable custom events: no events are sent for them.
# Example: https://smartcutai-analytics.<account>.workers.dev
VITE_ANALYTICS_ENDPOINT=
# Cloudflare Web Analytics beacon token (Cloudflare dashboard -> Web Analytics ->
# Manage site -> the "token" value in the snippet). Leave empty to disable Web
# Analytics. The beacon loads only after the visitor allows analytics.
VITE_CF_WEB_ANALYTICS_TOKEN=
