{
  "name": "remove-bg-photo",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Browser-first background remover for marketplace/product photos (Phase 1: model feasibility smoke test).",
  "scripts": {
    "dev": "vite --port 12000 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "node scripts/run-browser-tests.mjs",
    "eval:set": "python3 scripts/eval/build-eval-set.py --download",
    "eval:run": "node scripts/eval/run-eval.mjs",
    "eval:analyze": "python3 scripts/eval/analyze-eval.py eval-results/wasm",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "fetch-models": "node scripts/fetch-models.mjs",
    "dev:local": "vite",
    "license:audit": "license-checker-rseidelsohn --production && license-checker-rseidelsohn --summary",
    "vercel:build": "node scripts/fetch-models.mjs --webgpu --no-models && npm run build && node scripts/copy-legal-docs.mjs && node scripts/strip-large-assets.mjs"
  },
  "dependencies": {
    "onnxruntime-web": "1.29.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "license-checker-rseidelsohn": "^5.0.1",
    "onnxruntime-node": "^1.29.0",
    "puppeteer-core": "^23.11.1",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  }
}
