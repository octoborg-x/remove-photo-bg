# Dependencies
node_modules/

# Build output
dist/

# Model binaries (must not be committed; download via scripts/fetch-models.mjs)
public/models/*.onnx

# No WASM ignore rule: the whole public/wasm/ directory is committed. The
# loaders (ort.wasm.min.js, *.mjs) and the 13.3 MiB threaded binary
# (ort-wasm-simd-threaded.wasm) are all needed at runtime and are small enough
# for the repo; they are regenerated by scripts/fetch-models.mjs from the pinned
# onnxruntime-web version.

# OS / editor
.DS_Store
*.log
*.swp

# Local env (names only — no secrets in MVP)
.env
.env.local
# Measurement intermediates (regenerated by scripts/run-model-masks.py)
smoke-results/measurements/masks/
# Benchmark mask arrays and run output PNG (regenerated by scripts/benchmark-pipelines.py)
smoke-results/benchmark/masks/
smoke-results/fp16-wasm/output.png

# Python bytecode
__pycache__/
*.pyc

# T4 GPU benchmark mask arrays (regenerated by scripts/compare-models-gpu.py)
smoke-results/benchmark-t4/masks/

# Agent working memory (local only)
.openhands/
.vercel

# Cloudflare local state
.wrangler/
